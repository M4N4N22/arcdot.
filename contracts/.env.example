DEPLOYER_PRIVATE_KEY_TESTNET=
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# --- Arc Mainnet (submission / production) ---
DEPLOYER_PRIVATE_KEY_MAINNET=
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

